# Used only when running the API natively (npm run dev) against the
# dockerized Postgres container (which docker-compose.yml exposes on
# 127.0.0.1:5432). Copy to backend/.env for local development.
# When running the whole stack via `docker compose up`, these values
# come from the root .env / docker-compose.yml environment block instead.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://repairshop_admin:change_me_strong_password@localhost:5432/repairshop
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8080
